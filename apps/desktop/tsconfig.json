{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /*
     * The shared package is a sibling directory and deliberately not an npm
     * workspace (see the root package.json: each frontend installs and pins on its
     * own, and a workspace root without its own lockfile breaks npm ci for both
     * apps). Naming it here lets a component import @aether/ui/enums instead of
     * climbing out of the app, so moving a file is a move rather than a rewire of
     * every import inside it. vite.config.ts repeats the mapping, because the
     * bundler does not read compilerOptions.paths.
     */
    "baseUrl": ".",
    "paths": {
      "@aether/ui": ["../../packages/ui/src/index.ts"],
      "@aether/ui/*": ["../../packages/ui/src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Indexing an array or record yields `| undefined`, so `heroCopy[status]`
       cannot silently become `undefined` at render — the class of crash that
       white-screened the window when an unknown engine status arrived. */
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"],
  /*
   * Nothing is excluded: `npm run build` runs `tsc`, and the previous pattern only
   * named `*.test.ts`, so the build type-checked the component tests and skipped
   * the hook ones — the half of the suite that least looked like it was checked.
   * Vitest strips types rather than checking them, so this is the only place a
   * test file's types are verified.
   */
  "exclude": ["src-tauri", "node_modules", "dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
