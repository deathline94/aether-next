<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single appearance, deliberately: the surface is a dark-only WebView whose
         tokens set `color-scheme: dark` and paint #0D1113. Parenting this at
         `Theme.MaterialComponents.DayNight` while hardcoding dark chrome gave the
         system's *light* variant light widget colours and dark status-bar icons
         around a black page — invisible icons on a black bar, in light mode. One
         dark theme is the fix; a `values-night/themes.xml` copy would only add a
         second file to keep in step. -->
    <style name="Theme.Aether" parent="Theme.MaterialComponents.NoActionBar">
        <!-- #66E3A4 is the brand mint (packages/ui/brand/aether-mark.svg names it
             against this file), not a drift from the UI's emerald accent token. -->
        <item name="colorPrimary">#66E3A4</item>
        <item name="colorPrimaryVariant">#173B2C</item>
        <item name="colorOnPrimary">@color/app_canvas</item>
        <item name="android:statusBarColor">@color/app_canvas</item>
        <item name="android:navigationBarColor">@color/app_canvas</item>
        <item name="android:windowBackground">@color/app_canvas</item>
        <!-- Light glyphs on a dark bar, whatever the OEM default says. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
