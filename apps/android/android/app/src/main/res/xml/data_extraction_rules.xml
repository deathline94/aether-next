<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" only covers Android 11 and lower (with fullBackupContent);
    an OEM may still honour a device-to-device transfer on 12+. Nothing this app
    stores is transferable: the identity is wrapped under a keystore key that
    exists on this device only, so a copied envelope is undecryptable at best.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
