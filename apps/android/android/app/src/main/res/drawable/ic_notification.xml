<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon (T223), carrying the same mark as every other surface (item 23).

  Android renders a notification small icon as a *silhouette*: every opaque pixel
  becomes solid white and the rest transparent. `R.mipmap.ic_launcher` was used here
  before, and the launcher mark is a filled rounded square, so the status bar showed
  an unreadable white blob.

  The mark needs no simplification for that pass, which is the reason it is drawn as
  two round-capped strokes rather than filled artwork: a stroke stays a stroke when
  the system flattens it. Geometry is byte-identical to
  `packages/ui/brand/aether-launcher-monochrome.xml` — same two `pathData` strings,
  at the 24-unit grid the launcher layer scales from — and nothing here depends on
  colour, so the tint the system applies is the only paint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.6,20 L10.1,6.2 Q12,2.2 13.9,6.2 L19.4,20" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2.9,16 H21.1" />
</vector>
