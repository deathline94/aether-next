<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon (T223).

  Android renders a notification small icon as a *silhouette*: every opaque pixel
  becomes solid white and the rest transparent. `R.mipmap.ic_launcher` was used
  here before, and the launcher mark is a filled rounded square, so the status bar
  showed an unreadable white blob.

  This is a monochrome 24dp vector — a tunnel arch with traffic passing through it
  — built only from outlines, with no background plate and nothing that depends on
  colour, so it survives the silhouette pass. The system tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Tunnel arch: a single closed outline, so no fill-rule tricks are needed. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,21 L4,11 A8,8 0 0 1 20,11 L20,21 L16,21 L16,11 A4,4 0 0 0 8,11 L8,21 Z" />
    <!-- Traffic leaving through the opening. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,15 L13,15 L13,13 L17.5,16.5 L13,20 L13,18 L10,18 Z" />
</vector>
