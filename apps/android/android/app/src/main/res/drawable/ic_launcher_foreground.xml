<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground layer (P1-2): the Aether padlock, authored to sit
     inside the 66% safe zone of the 108dp canvas (all geometry within the
     central ~66dp, clear of the ~18dp bleed margins the launcher may crop). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shackle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M40,54 V44 A14,14 0 0 1 68,44 V54" />
    <!-- body -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M40,54 h28 a6,6 0 0 1 6,6 v18 a6,6 0 0 1 -6,6 h-28 a6,6 0 0 1 -6,-6 v-18 a6,6 0 0 1 6,-6 z" />
    <!-- keyhole (punched to the background colour) -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M54,63 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 z" />
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M52,64 h4 v11 a2,2 0 0 1 -4,0 z" />
</vector>
