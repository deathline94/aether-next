{
  "name": "aether-mobile",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-tokens.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync-www": "npm run build && node scripts/sync-www.mjs",
