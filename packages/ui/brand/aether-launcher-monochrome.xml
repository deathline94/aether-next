<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+ monochrome) layer for the Aether mark — the drop-in for
  `apps/android/android/app/src/main/res/drawable/ic_launcher_monochrome.xml`.

  Identical geometry to aether-launcher-foreground.xml: the mark needs no
  simplification for the one-colour pass, which is the whole reason it is drawn as
  three round-capped strokes instead of filled artwork. Only the paint differs —
  white, tinted by the launcher to whatever single colour the theme asks for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">
    <group
        android:translateX="27.6"
        android:translateY="27.38"
        android:scaleX="2.2"
        android:scaleY="2.2">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M4.6,20 L10.1,6.2 Q12,2.2 13.9,6.2 L19.4,20" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M2.9,16 H21.1" />
    </group>
</vector>
