<?xml version="1.0" encoding="utf-8"?>
<!--
  Android adaptive-icon foreground layer for the Aether mark — the drop-in for
  `apps/android/android/app/src/main/res/drawable/ic_launcher_foreground.xml`.

  It is the SAME two paths recorded in aether-mark.svg, beside this file (the portal
  and the line), not a redraw: the 24-unit geometry is scaled by 2.2, which puts the
  mark's bounding diagonal at 63.1dp — inside the adaptive icon's 66dp safe zone,
  so no launcher mask can clip a stroke. Centre: the geometry's own bounds are
  1.29..22.71 x 2.55..21.65, i.e. centred at (12, 12.1), so translate =
  54 - 12 * 2.2 = 27.6 on x and 54 - 12.1 * 2.2 = 27.38 on y.

  The stroke stays 3.3 in geometry units because the group transform scales it
  with everything else: it paints at 7.3dp on the 108dp canvas.

  Colour is the same @color resource the current layer uses, so values/ and
  values-night/ keep retheming it (#66E3A4 day, #7CF0B8 night) with no edit here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="27.6"
        android:translateY="27.38"
        android:scaleX="2.2"
        android:scaleY="2.2">
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/ic_launcher_foreground"
            android:strokeWidth="3.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M4.6,20 L10.1,6.2 Q12,2.2 13.9,6.2 L19.4,20" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/ic_launcher_foreground"
            android:strokeWidth="3.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M2.9,16 H21.1" />
    </group>
</vector>
