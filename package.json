{
  "name": "aether-workspace",
  "private": true,
  "version": "1.2.9",
  "description": "Aether monorepo workspace: shared UI package + desktop (Tauri) + Android (WebView) apps",
  "workspaces": [
    "packages/ui",
    "apps/desktop",
    "apps/android"
  ],
  "scripts": {
    "build:ui": "npm run build --workspace @aether/ui",
    "build:desktop": "npm run build --workspace aether-desktop",
    "build:android": "npm run build --workspace aether-android",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify-invariants": "node scripts/verify-invariants.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
